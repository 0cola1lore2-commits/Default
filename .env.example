# Copiază acest fișier ca `.env` și completează valorile. Pornește cu `npm start`.

# Portul și adresa pe care ascultă serverul.
# În containere / pe un server public folosește HOST=0.0.0.0
PORT=3000
HOST=127.0.0.1

# Acces la panoul de administrare: /admin
# Dacă ADMIN_PASSWORD lipsește, la fiecare pornire se generează o parolă nouă (afișată în consolă).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Adresa publică a site-ului (apare în notificări)
PUBLIC_URL=http://localhost:3000

# Notificare la fiecare comandă nouă (opțional). Funcționează cu webhook-uri de tip
# Slack / Mattermost / Discord / Microsoft Teams (incoming webhook).
NOTIFY_WEBHOOK_URL=

# Câte proxy-uri de încredere (nginx, Cloudflare, load balancer) sunt în fața aplicației.
# 0 = niciunul. Necesar ca limitarea pe IP să vadă IP-ul real al clientului.
TRUST_PROXY=0

# Unde se salvează comenzile (fișierul orders.json). Fă backup periodic acestui director.
DATA_DIR=./data

# Pe server setează NODE_ENV=production (cache pentru pagini)
NODE_ENV=production
